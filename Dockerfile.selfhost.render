# Combined self-host image: the OpenSEO app + the render pipeline's Chrome
# runtime, in ONE container instead of two separate services.
#
# DELIBERATELY builds FROM the already-published upstream image instead of
# duplicating Dockerfile.selfhost's build steps. This file shares zero
# content with Dockerfile.selfhost, so upstream is free to change how the app
# itself is built (base image, install steps, entrypoint) without ever
# producing a merge conflict here on `fork/main` sync. Rebuilding this image
# always picks up whatever BASE_IMAGE currently resolves to.
ARG BASE_IMAGE=ghcr.io/every-app/open-seo:latest
FROM ${BASE_IMAGE}

# Runtime libraries required by Puppeteer's bundled Chromium on Debian
# bookworm — same base OS as the upstream image (both start FROM node:22).
# Mirrors renderer/Dockerfile's list exactly; see
# https://pptr.dev/troubleshooting#running-on-alpine-and-linux.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libexpat1 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxkbcommon0 \
        libxrandr2 \
        libxrender1 \
        libxshmfence1 \
        libxss1 \
        libxtst6 \
        xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# renderer/ is fork-only — it does NOT exist in every-app/open-seo upstream,
# so it is never present in the published BASE_IMAGE (that image is built
# from upstream's own tree). Copy it explicitly from THIS build's context
# (the fork checkout) instead of assuming it's already there.
WORKDIR /app/renderer
COPY renderer/package.json renderer/package-lock.json ./
RUN npm ci
COPY renderer/tsconfig.json ./
COPY renderer/src ./src
RUN npm run build && npm prune --omit=dev
WORKDIR /app

# The /api/render/ endpoint itself (route handler, render-report service,
# templates, auth, R2 cache — everything under src/routes/api/render/ and
# src/server/lib/render/) is ALSO fork-only, same as renderer/ above: it was
# never merged upstream (verified via `git log upstream/main -- src/routes/api/render/`
# — zero commits), so the published BASE_IMAGE's /app/src does not contain it
# either. Without this, the container builds and boots fine (health check
# passes) but every request to /api/render/ 404s to the SPA shell, since the
# route was never compiled in. Overwrite the base image's src/ with this
# fork's own — same fix pattern as the renderer/ copy above, just scoped to
# the app side of the same feature instead of the microservice side.
#
# `COPY <dir> <dest>` does NOT replace an existing destination directory, it
# MERGES into it — files already in BASE_IMAGE's /app/src that this fork's
# src/ doesn't also have are left untouched. That is safe only as long as
# fork/main and BASE_IMAGE:latest are in sync. When upstream ships a release
# fork/main hasn't merged yet (e.g. BASE_IMAGE picks up a new upstream file
# that imports from a schema module this fork's own, older version of that
# same-named file no longer — or doesn't yet — export), the merge produces an
# inconsistent hybrid tree: Rollup fails to resolve the import, the container
# never finishes building, and it crash-loops forever under the restart
# policy. `rm -rf` first so this is always a clean replace — the image always
# runs exactly fork/main's own `src/`, never a mix.
RUN rm -rf src
COPY src ./src

# The published BASE_IMAGE ships upstream's own tsconfig.json, which does NOT
# exclude renderer/**/* (upstream doesn't know that directory exists). The
# app's own startup build (docker-entrypoint.sh -> `pnpm run build` ->
# `vite build && tsc --noEmit`) type-checks against WHATEVER tsconfig.json is
# on disk at /app — so without overwriting it here, renderer/ gets swept into
# the root type-check with the wrong lib settings (DOM included) and fails
# with the exact TS2345 error this fork's tsconfig.json (renderer/**/* in its
# `exclude`) already fixed for every other build path. Overlay our fork's
# version explicitly, the same fix pattern as the renderer/ copy above.
COPY tsconfig.json ./

COPY docker-entrypoint.combined.sh ./

EXPOSE 3001

# Same probe as Dockerfile.selfhost (unmodified) — the combined entrypoint
# still ends by running the original app startup in the foreground.
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

CMD ["sh", "docker-entrypoint.combined.sh"]
