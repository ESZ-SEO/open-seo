# Combined self-host image: the OpenSEO app + the render pipeline's Chrome
# runtime, in ONE container instead of two separate services.
#
# DELIBERATELY builds FROM the already-published upstream image instead of
# duplicating Dockerfile.selfhost's build steps. This file shares zero
# content with Dockerfile.selfhost, so upstream is free to change how the app
# itself is built (base image, install steps, entrypoint) without ever
# producing a merge conflict here on `fork/main` sync. Rebuilding this image
# always picks up whatever BASE_IMAGE currently resolves to.
ARG BASE_IMAGE=ghcr.io/every-app/open-seo:latest
FROM ${BASE_IMAGE}

# Runtime libraries required by Puppeteer's bundled Chromium on Debian
# bookworm — same base OS as the upstream image (both start FROM node:22).
# Mirrors renderer/Dockerfile's list exactly; see
# https://pptr.dev/troubleshooting#running-on-alpine-and-linux.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libexpat1 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxkbcommon0 \
        libxrandr2 \
        libxrender1 \
        libxshmfence1 \
        libxss1 \
        libxtst6 \
        xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# renderer/ is fork-only — it does NOT exist in every-app/open-seo upstream,
# so it is never present in the published BASE_IMAGE (that image is built
# from upstream's own tree). Copy it explicitly from THIS build's context
# (the fork checkout) instead of assuming it's already there.
WORKDIR /app/renderer
COPY renderer/package.json renderer/package-lock.json ./
RUN npm ci
COPY renderer/tsconfig.json ./
COPY renderer/src ./src
RUN npm run build && npm prune --omit=dev
WORKDIR /app

COPY docker-entrypoint.combined.sh ./

EXPOSE 3001

# Same probe as Dockerfile.selfhost (unmodified) — the combined entrypoint
# still ends by running the original app startup in the foreground.
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

CMD ["sh", "docker-entrypoint.combined.sh"]
