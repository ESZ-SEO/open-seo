{
  "name": "openseo-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTML to PNG screenshot microservice for OpenSEO visual reports.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.12.25",
    "puppeteer": "^24.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
